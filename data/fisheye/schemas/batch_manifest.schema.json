{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sightrefiner.local/schemas/fisheye/batch_manifest.schema.json",
  "title": "SightRefiner Fisheye Batch Manifest",
  "description": "Optional local manifest for a fisheye test batch. The manifest records script entry points and standard directories, but raw input details remain batch-specific.",
  "type": "object",
  "required": ["batch_id", "module", "paths", "scripts"],
  "additionalProperties": true,
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_[A-Za-z0-9_.-]+$"
    },
    "module": {
      "const": "fisheye"
    },
    "description": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "required": ["raw", "images", "report"],
      "additionalProperties": false,
      "properties": {
        "raw": {
          "const": "raw"
        },
        "images": {
          "const": "images"
        },
        "report": {
          "const": "report"
        }
      }
    },
    "scripts": {
      "type": "object",
      "required": ["preprocess", "report"],
      "additionalProperties": false,
      "properties": {
        "preprocess": {
          "type": "string",
          "pattern": "^(preprocess\\.py|preprocess/[A-Za-z0-9_.-]+\\.py|tools/[A-Za-z0-9_/.-]+\\.py)$"
        },
        "report": {
          "type": "string",
          "pattern": "^(make_report\\.py|report\\.py|report/[A-Za-z0-9_.-]+\\.py|tools/[A-Za-z0-9_/.-]+\\.py)$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sites": {
          "type": "integer",
          "minimum": 0
        },
        "cameras": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
